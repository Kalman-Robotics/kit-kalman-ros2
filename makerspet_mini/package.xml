<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>makerspet_mini</name>
  <version>0.0.0</version>
  <description>ROS2 package for Robotics Kalman Kit. Maker's Pet Mini ROS2 educational robot</description>
  <maintainer email="kalmanrobotics@gmail.com">Kalman Robotics</maintainer>
  <license>Apache 2.0</license>
  <url type="website">https://kalmanrobotics.io/</url>
  <url type="repository">https://github.com/Kalman-Robotics/kit-kalman-ros2</url>
  <url type="bugtracker">https://github.com/Kalman-Robotics/kit-kalman-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/sdf"/>
  </export>
</package>
