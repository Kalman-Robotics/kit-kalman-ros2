<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kalman_telemetry</name>
  <version>0.0.0</version>
  <description>ROS2 package for Robotics Kalman Kit. Micro-ROS telemetry</description>
  <maintainer email="kalmanrobotics@gmail.com">Kalman Robotics</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://kalmanrobotics.io/</url>
  <url type="repository">https://github.com/Kalman-Robotics/kit-kalman-ros2</url>
  <url type="bugtracker">https://github.com/Kalman-Robotics/kit-kalman-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>kalman_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- depend diagnostic_msgs depend -->
  <depend>tf2_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
